# Copia este fichero como backend/.env para desarrollo local (lo carga api/entorno.py).
# En producción, estas variables se configuran en Vercel (Settings → Environment Variables).

# Perfil: nombre de la persona a la que representa el chatbot
PERFIL_NOMBRE="<nombre-y-apellidos>"

# Orígenes del frontend permitidos por CORS, separados por comas
ALLOWED_ORIGINS="http://localhost:4200,https://<tu-usuario>.github.io"

# Upstash Vector (base de datos vectorial del RAG)
UPSTASH_VECTOR_REST_URL="https://<tu-indice>-vector.upstash.io"
UPSTASH_VECTOR_REST_TOKEN="<token-upstash-vector>"

# Upstash Redis (límite de peticiones)
UPSTASH_REDIS_REST_URL="https://<tu-base>.upstash.io"
UPSTASH_REDIS_REST_TOKEN="<token-upstash-redis>"

# OpenAI (LLM)
OPENAI_API_KEY="sk-proj-..."

# Telegram (avisos de contactos y preguntas sin respuesta)
TELEGRAM_BOT_TOKEN="<token-bot-telegram>"
TELEGRAM_CHAT_ID="<chat-id-telegram>"

# Resend (envío de correos del formulario de contacto)
RESEND_API_KEY="re_..."
CONTACT_FROM="Portfolio <onboarding@resend.dev>"
CONTACT_TO="<tu-correo>"

# Secreto con el que Vercel Cron llama a /api/health (keep-alive de Upstash)
CRON_SECRET="<cadena-aleatoria-larga>"

# Opcional: 1 reactiva el evaluador-optimizador (desactivado por defecto: no
# mejoraba la calidad y añadía ~1 s y coste por mensaje; ver README)
# USAR_EVALUADOR="1"
